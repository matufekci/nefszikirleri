# Gemini API key (if using Firebase AI / Vertex)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase App Check debug token (optional)
# Get your debug token from logcat when running debug build: search for "DebugAppCheckProvider"
# Then add it to Firebase Console -> App Check -> Manage debug tokens
FIREBASE_APPCHECK_DEBUG_TOKEN=your_debug_token_here

# Release signing (optional, for CI / production)
# Provide real keystore for assembleRelease, otherwise debug fallback will be used for debug builds
# RELEASE_KEYSTORE_PATH=/path/to/release.keystore
# RELEASE_STORE_PASSWORD=store_password
# RELEASE_KEY_ALIAS=key_alias
# RELEASE_KEY_PASSWORD=key_password

# Alternative env names (legacy support)
# KEYSTORE_PATH=/path/to/release.keystore
# STORE_PASSWORD=store_password
# KEY_ALIAS=key_alias
# KEY_PASSWORD=key_password

# App version info (optional, for CI tagging)
# VERSION_CODE=3
# VERSION_NAME=2.1
