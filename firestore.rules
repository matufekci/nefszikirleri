rules_version = '2';

// Nefs Zikirleri - Firestore guvenlik kurallari.
//
// NEDEN BU DOSYA: "Buluta Yedekle" PERMISSION_DENIED veriyordu ama "Geri
// Yukle" (okuma) calisiyordu. Sebep: Firestore kurallari HIYERARSIK DEGILDIR;
// /users/{uid} icin verilen izin, altindaki snapshots/ ve history/
// alt-koleksiyonlarini KAPSAMAZ. Uygulama yedek yazarken uc seviyeye de
// yazdigi icin (users/<uid>, users/<uid>/snapshots/<sid> ve
// users/<uid>/snapshots/<sid>/history/*) her seviye ayrica izin istiyor.
//
// KURULUM: Firebase Console -> Firestore Database -> Rules sekmesi ->
// asagidaki icerigi yapistir -> Publish. (App Check ayrica "Unenforced"
// birakilmalidir; debug build token'i konsola kayitli degildir.)

service cloud.firestore {
  match /databases/{database}/documents {

    // Yalnizca giris yapmis kullanici KENDI belgelerine erisir.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /snapshots/{snapshotId} {
        allow read, write: if isOwner(userId);

        match /history/{doc} {
          allow read, write: if isOwner(userId);
        }
      }

      // Eski surum gecmisi (legacy) okuma/yazma yolu.
      match /history/{doc} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
